          "id": "TwoColumnText",
          "content": {
            "eyebrow": "How we work",
            "headline": "Slow, on purpose.",
            "paragraphs": [
              { "heading": "One project at a time.", "body": "Every senior at the studio leads one engagement end to end. No swarming, no parallelization, no junior teams." },
              { "heading": "Four-day week.", "body": "We work Monday to Thursday. Friday is for studio research, writing, and rest. The cadence is not a perk; it is what makes the work hold up." },
              { "heading": "No agencies in disguise.", "body": "We do not subcontract. Everyone on a project is in the room — direction, design, engineering — for the full six weeks." }
            ]
