          "id": "FAQAccordion",
          "content": {
            "eyebrow": "Frequently Asked",
            "headline": "Everything You Need to Know",
            "faqs": [
              {
                "q": "Is QuantaPay secure?",
                "a": "Yes. We use advanced encryption, two-factor authentication, and AI-driven fraud detection to keep your funds and data safe at all times."
              },
              {
                "q": "How quickly can I set up my account?",
                "a": "Most businesses are approved within minutes, with instant access to all core features after verification."
              },
              {
                "q": "Which currencies do you support?",
                "a": "QuantaPay supports over 27 global currencies, including USD, EUR, GBP, SGD, and JPY. More are added regularly."
              },
              {
                "q": "Can I integrate with my existing systems?",
                "a": "Absolutely. Our Open Banking APIs and pre-built integrations make it easy to connect with your current workflows."
              },
              {
                "q": "What support options are available?",
                "a": "Our dedicated support team is available 24/7 via chat, email, and phone for all account tiers."
              }
            ]
          }
