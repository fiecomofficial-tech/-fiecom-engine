          "id": "FAQAccordion",
          "content": {
            "eyebrow": "Questions?",
            "headline": "Frequently Asked Questions",
            "body": "Everything you need to know before getting started with ClarityPay.",
            "faqs": [
              {
                "q": "Is there a setup fee or long-term contract?",
                "a": "No, ClarityPay has zero setup fees and no long-term contracts. Cancel anytime."
              },
              {
                "q": "Which currencies does ClarityPay support?",
                "a": "We support USD, EUR, GBP, and over 20 additional currencies for seamless international payments."
              },
              {
                "q": "How quickly are funds transferred?",
                "a": "Most payouts are instant or arrive within 1 business day, depending on the recipient bank."
              },
              {
                "q": "Is my data secure with ClarityPay?",
                "a": "Absolutely. We use advanced encryption and comply with top security standards including SOC 2 and PCI DSS."
              },
              {
                "q": "Can I integrate ClarityPay with my own software?",
                "a": "Yes, our open API makes it easy to connect your systems for custom payment workflows."
              }
            ]
          }
