            "headline": "Your Questions, Answered",
            "faqs": [
              {
                "q": "How far in advance should I book a flight?",
                "a": "We recommend booking at least 24-48 hours ahead to ensure preferred aircraft availability, but we can often accommodate urgent requests."
              },
              {
                "q": "Can I bring pets on board?",
                "a": "Yes, AeroLuxe welcomes pets and will make all necessary arrangements for their comfort and safety. Please inform us in advance."
              },
              {
                "q": "Which airports can I use with AeroLuxe?",
                "a": "You can access major and regional airports, plus exclusive private terminals at over 6,000 locations worldwide."
              },
              {
                "q": "Is there Wi-Fi on every flight?",
                "a": "Most aircraft in our fleet offer high-speed Wi-Fi. Please request this amenity if needed when booking your flight."
              },
              {
                "q": "How does onboard catering work?",
                "a": "Menus are fully customizable. Enjoy chef-prepared meals tailored to your tastes, dietary needs, and desired cuisine."
              }
            ]
